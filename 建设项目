// .prettierrc.js
module.exports = {
  semi: false,          // 不使用分号
  singleQuote: true,    // 使用单引号
  printWidth: 100,      // 每行代码最大长度
  tabWidth: 2,          // 缩进空格数
  useTabs: false,       // 使用空格缩进
  trailingComma: 'none', // 无尾随逗号
  bracketSpacing: true,  // 对象括号空格: { foo: bar }
  arrowParens: 'avoid',  // 箭头函数单参数省略括号: x => x
  endOfLine: 'auto'     // 自动识别换行符
}

